# MongoDB Atlas connection string (create a dedicated DB user, not your Atlas account login)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/labwala?retryWrites=true&w=majority

# Long, random secret used to sign login tokens — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Admin/seller login credentials — pick strong, unique passwords (not defaults!)
ADMIN_USERNAME=
ADMIN_PASSWORD=
SELLER_USERNAME=
SELLER_PASSWORD=

# Comma-separated list of frontend origin(s) allowed to call this API
CLIENT_URL=https://your-frontend.vercel.app

# Local dev only — Vercel provides PORT/VERCEL automatically
PORT=5000
